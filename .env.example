# Copie para .env e preencha. O binário carrega .env no dev (dotenvy); em produção use variáveis de ambiente do usuário.
# Só preencha as que você tiver — provider sem chave é ignorado pelo scheduler.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral La Plateforme (Experiment tier) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# GitHub Models — PAT fine-grained com permissão "Models: read" — https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=

# OpenRouter — https://openrouter.ai/settings/keys  (US$10 lifetime libera 1k req/dia nos :free)
OPENROUTER_API_KEY=

# DeepSeek (pago, centavos) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Anthropic: NÃO precisa de chave aqui. O gateway faz passthrough do auth que o Claude Code envia.

# Servidor
OPENKAX_BIND=127.0.0.1:8000
OPENKAX_CONFIG=./providers.toml
OPENKAX_LOG=info
