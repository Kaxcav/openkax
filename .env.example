# Copie para .env e preencha. O binário carrega .env no dev (dotenvy); em produção use variáveis de ambiente do usuário.
# Só preencha as que você tiver — provider sem chave é ignorado pelo scheduler e pulado pelo doctor.

# ===== Tier 1 — espinha dorsal =====
# Google AI Studio — https://aistudio.google.com/apikey  (Flash/Flash-Lite free; 1M ctx; free tier USA prompts para treino fora da UE)
GEMINI_API_KEY=
# Mistral La Plateforme (Experiment) — https://console.mistral.ai/api-keys  (1B tok/mês, 2 RPM, 500k TPM)
MISTRAL_API_KEY=
# Codestral endpoint dedicado — https://console.mistral.ai/codestral  (chave e quota SEPARADAS da La Plateforme; ~60 RPM)
CODESTRAL_API_KEY=
# NVIDIA API Catalog (NIM) — https://build.nvidia.com  (100+ modelos, ~40 RPM, sem cap diário publicado; ToS: dev/test, não mandar dado confidencial)
NVIDIA_API_KEY=

# ===== Tier 2 — backups free =====
# Groq — https://console.groq.com/keys  (8k TPM; bloqueia redes corporativas/VPN com 403)
GROQ_API_KEY=
# GitHub Models — PAT fine-grained com "Models: read" — https://github.com/settings/personal-access-tokens
GITHUB_MODELS_TOKEN=
# Z.ai (Zhipu) — https://z.ai/model-api  (GLM-4.7-Flash free no price sheet, 200K ctx, concorrência 1; >8K ctx é estrangulado)
ZAI_API_KEY=
# Cloudflare Workers AI — token com permissão "Workers AI: Read" + Account ID do dashboard  (10k neurons/dia; endpoint OpenAI-compat em /accounts/<id>/ai/v1)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# SambaNova Cloud — https://cloud.sambanova.ai  (20 RPM, 20 RPD por modelo, 200k TPD; muito rápido)
SAMBANOVA_API_KEY=
# Cohere trial — https://dashboard.cohere.com/api-keys  (1000 calls/mês, 20 RPM, não comercial; família diferente → bom para kax/reviewer)
COHERE_API_KEY=
# Alibaba Model Studio (Qwen, região Singapura) — https://modelstudio.console.alibabacloud.com  (1M tokens por modelo, 90 dias; LIGUE "Free Quota Only" senão vira pay-as-you-go)
DASHSCOPE_API_KEY=

# ===== Tier 3 — agregadores e pagos =====
# OpenRouter — https://openrouter.ai/settings/keys  (US$10 lifetime libera 1k req/dia nos :free)
OPENROUTER_API_KEY=
# Vercel AI Gateway — https://vercel.com/d?to=/[team]/~/ai-gateway  (US$5/mês de crédito free, zero markup; some se você comprar crédito)
VERCEL_AI_GATEWAY_KEY=
# DeepSeek (pago, centavos) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Anthropic: NÃO precisa de chave aqui. O gateway faz passthrough do auth que o Claude Code envia.

# ===== Servidor =====
OPENKAX_BIND=127.0.0.1:8000
OPENKAX_CONFIG=./providers.toml
OPENKAX_LOG=info
