# Copie para .env e preencha. O binário carrega .env no dev (dotenvy); em produção use variáveis de ambiente do usuário.
# Só preencha as que você tiver — provider sem chave é ignorado pelo scheduler.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral La Plateforme (Experiment tier) — https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/settings/keys  (US$10 lifetime libera 1k req/dia nos :free)
OPENROUTER_API_KEY=

# DeepSeek (pago, centavos) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---- providers de cauda (ADR 0004) ----

# NVIDIA build — https://build.nvidia.com (40 RPM)
NVIDIA_API_KEY=

# Vercel AI Gateway — https://vercel.com/dashboard → AI Gateway → API keys (tier "credit": só modelos de preço 0)
# Desligada no providers.toml: exige cartão de crédito cadastrado (403), mesmo para modelo grátis.
VERCEL_AI_GATEWAY_KEY=

# Z.ai — https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=

# Cloudflare Workers AI — o ID da conta entra na base_url via ${CLOUDFLARE_ACCOUNT_ID};
# token com permissão "Workers AI: Read" — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cohere (trial: 20 RPM, 1000 chamadas/mês) — https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# SambaNova Cloud — https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# Anthropic: NÃO precisa de chave aqui. O gateway faz passthrough do auth que o Claude Code envia.

# Servidor
OPENKAX_BIND=127.0.0.1:8000
OPENKAX_CONFIG=./providers.toml
OPENKAX_LOG=info
